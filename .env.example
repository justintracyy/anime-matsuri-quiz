# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API. Either the legacy anon key or the new publishable key works.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Never expose this to the browser. (Legacy service_role key or new secret key.)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ── Organizer access ─────────────────────────────────────────────────────
# Password used on /login to reach the dashboard and host screens.
ADMIN_PASSWORD=change-me-to-something-long
# Random string, at least 32 characters, used to sign the organizer session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-random-32-plus-character-string

# ── Optional ─────────────────────────────────────────────────────────────
# Public URL used in the lobby QR code. Defaults to the host browser's origin.
NEXT_PUBLIC_SITE_URL=
